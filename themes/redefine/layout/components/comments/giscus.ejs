<%
    const giscusConfig = theme.comment.config.giscus || {};
    const giscusStrict = String(giscusConfig.strict ?? '0');
    const giscusReactions = String(giscusConfig.reactions_enabled ?? '1');
    const giscusMetadata = String(giscusConfig.emit_metadata ?? '0');
%>
<% if (
        theme.comment.system==='giscus' &&
        giscusConfig.repo &&
        giscusConfig.repo_id &&
        giscusConfig.category_id
    ) { %>
    <div id="giscus-container" class="giscus-container" aria-live="polite">
        <div class="giscus-loading" role="status">正在加载评论…</div>
    </div>
    <script <%= theme.global.single_page === true && 'data-swup-reload-script' %> defer>
        (function() {
            const containerId = "giscus-container";
            const mapping = "<%= giscusConfig.mapping || 'pathname' %>";
            const lang = "<%= giscusConfig.lang || 'en' %>";
            const inputPosition = "<%= giscusConfig.input_position || 'top' %>";
            const reactionsEnabled = "<%= giscusReactions %>" === "1";
            const emitMetadata = "<%= giscusMetadata %>" === "1";
            const strict = "<%= giscusStrict %>" === "1";
            const loading = "<%= giscusConfig.loading || 'lazy' %>";
            const lightThemeUrl = new URL("<%= url_for('css/giscus-comment-light.css?v=2') %>", location.origin).href;
            const darkThemeUrl = new URL("<%= url_for('css/giscus-comment-dark.css?v=2') %>", location.origin).href;

            const getSiteTheme = () =>
                document.documentElement.classList.contains("dark")
                    ? darkThemeUrl
                    : lightThemeUrl;

            const getTerm = () => {
                if (mapping === "pathname") return location.pathname;
                if (mapping === "url") return location.href;
                if (mapping === "title") return document.title;
                if (mapping === "og:title") {
                    const ogTitle = document.querySelector("meta[property='og:title']");
                    return ogTitle?.content || document.title;
                }
                return "";
            };

            const sendUpdate = () => {
                const container = document.getElementById(containerId);
                const iframe = container?.querySelector("iframe.giscus-frame");
                if (!iframe) {
                    return;
                }

                const setConfig = {
                    theme: getSiteTheme(),
                    lang,
                    inputPosition,
                    reactionsEnabled,
                    emitMetadata,
                    strict,
                };

                if (mapping !== "number") {
                    const term = getTerm();
                    if (term) {
                        setConfig.term = term;
                    }
                }

                iframe.contentWindow.postMessage(
                    { giscus: { setConfig } },
                    "https://giscus.app",
                );
            };

            const loadGiscus = () => {
                const container = document.getElementById(containerId);
                if (!container) {
                    return;
                }

                const iframe = container.querySelector("iframe.giscus-frame");
                if (iframe) {
                    sendUpdate();
                    return;
                }

                if (container.dataset.giscusInit === "true") {
                    return;
                }

                const giscusConfig = {
                    src: "https://giscus.app/client.js",
                    "data-repo": "<%= giscusConfig.repo %>",
                    "data-repo-id": "<%= giscusConfig.repo_id %>",
                    "data-category": "<%= giscusConfig.category %>",
                    "data-category-id": "<%= giscusConfig.category_id %>",
                    "data-mapping": mapping,
                    "data-strict": "<%= giscusStrict %>",
                    "data-reactions-enabled": "<%= giscusReactions %>",
                    "data-emit-metadata": "<%= giscusMetadata %>",
                    "data-theme": getSiteTheme(),
                    "data-lang": lang,
                    "data-input-position": inputPosition,
                    "data-loading": loading,
                    crossorigin: "anonymous",
                    async: true,
                };

                const giscusScript = document.createElement("script");
                for (const key in giscusConfig) {
                    giscusScript.setAttribute(key, giscusConfig[key]);
                }
                container.appendChild(giscusScript);
                container.dataset.giscusInit = "true";

                const observer = new MutationObserver(() => {
                    if (container.querySelector("iframe.giscus-frame")) {
                        container.classList.add("is-ready");
                        observer.disconnect();
                    }
                });
                observer.observe(container, { childList: true, subtree: true });
            };

            const runGiscus = () => {
                const container = document.getElementById(containerId);
                if (!container) {
                    return;
                }

                if (container.querySelector("iframe.giscus-frame")) {
                    sendUpdate();
                    return;
                }

                loadGiscus();
            };

            runGiscus();
        })();
    </script>
<% } %>
