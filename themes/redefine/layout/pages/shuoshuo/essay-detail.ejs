<%
const essay = page.essay || {};
const momentDate = typeof essay.date === 'string'
  ? moment(essay.date, ['YYYY-MM-DD HH:mm:ss', 'YYYY-MM-DD HH:mm'], true)
  : moment(essay.date);
const exactDate = momentDate.isValid() ? momentDate.format('YYYY-MM-DD HH:mm') : essay.date;
const relativeDateValue = momentDate.isValid() ? momentDate.format() : essay.date;
const imageCount = essay.images ? essay.images.length : 0;
const gridStyle = imageCount === 1
  ? 'grid-template-columns:minmax(0,1fr);max-width:22rem;gap:0.625rem;'
  : (imageCount === 2 || imageCount === 4)
    ? 'grid-template-columns:repeat(2,minmax(0,1fr));max-width:38rem;gap:0.625rem;'
    : 'grid-template-columns:repeat(3,minmax(0,1fr));max-width:38rem;gap:0.625rem;';
const imageStyle = imageCount === 1
  ? 'height:16rem;width:100%;object-fit:cover;'
  : 'aspect-ratio:1 / 1;width:100%;object-fit:cover;';
%>
<div class="page-template-container">
	<div class="page-template-content markdown-body">
		<%
        const authorName = config.author || config.title || 'Yigod';
        %>
		<div class="flex flex-col gap-5">
			<a href="/essays/" class="inline-flex w-fit items-center rounded-full bg-zinc-100 px-3 py-1 text-sm text-third-text-color transition-colors hover:text-primary-color dark:bg-zinc-800">返回说说列表</a>
			<div class="overflow-hidden rounded-[1.8rem] bg-transparent">
				<div class="flex flex-col gap-5">
					<div class="flex flex-wrap items-start justify-between gap-4">
						<div class="flex items-start gap-4">
							<div class="h-10 w-10 overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800">
								<%- image_tag(theme.defaults.avatar, {class: "h-full w-full rounded-[1rem] object-cover"}) %>
							</div>
							<div class="flex flex-col gap-1.5">
								<div class="text-[15px] font-semibold text-first-text-color"><%= authorName %></div>
								<div class="essay-date flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-third-text-color" data-date="<%= relativeDateValue %>">
									<span class="font-medium essay-date-exact"><%= exactDate %></span>
								</div>
							</div>
						</div>
						<div class="rounded-full bg-zinc-100 px-3 py-1 text-[11px] uppercase tracking-[0.18em] text-third-text-color dark:bg-zinc-800">
							<%= imageCount ? `${imageCount} Photos` : 'Moment' %>
						</div>
					</div>
					<div class="flex flex-wrap items-center gap-2">
						<h1 class="page-title-header !mb-0"><%= page.title %></h1>
				<% if (essay.pinned) { %>
						<span class="inline-flex items-center rounded-full border border-amber-300/70 bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 dark:border-amber-500/40 dark:bg-amber-500/10 dark:text-amber-200">置顶</span>
				<% } %>
					</div>
					<div class="essay-detail-content text-[15px] leading-8">
						<%- markdown(essay.content || '') %>
					</div>
			<% if (essay.images && essay.images.length) { %>
					<div class="essay-detail-media-grid grid gap-2.5" style="<%= gridStyle %>">
				<% for (const image of essay.images.slice(0, 9)) { %>
						<button type="button" style="padding:0;line-height:0;" class="block overflow-hidden rounded-[1rem] bg-[var(--card-background-color)]">
							<img src="<%= image %>" alt="essay image" loading="lazy" style="<%= imageStyle %>" class="cursor-zoom-in transition-transform duration-300 hover:scale-[1.03]">
						</button>
				<% } %>
					</div>
			<% } %>
			<% if (essay.videos && essay.videos.length) { %>
					<div class="flex flex-col gap-3">
				<% for (const video of essay.videos) { %>
						<video controls preload="metadata" style="height:16rem;width:100%;max-width:22rem;object-fit:cover;" class="rounded-[1rem] bg-black">
							<source src="<%= video %>">
						</video>
				<% } %>
					</div>
			<% } %>
			<% if (essay.location_name) { %>
					<div class="flex flex-wrap items-center gap-2 text-sm text-third-text-color">
						<span class="inline-flex items-center rounded-full bg-zinc-100 px-3 py-1 dark:bg-zinc-800">
							地点 · <%= essay.location_name %>
				</span>
				<% if (essay.location_url) { %>
						<a href="<%= essay.location_url %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full bg-zinc-100 px-3 py-1 hover:text-primary-color dark:bg-zinc-800">
							查看地址
						</a>
				<% } %>
					</div>
			<% } %>
					<div class="flex flex-wrap items-center gap-2 border-t border-border-color/60 pt-3 text-sm">
				<button
					type="button"
							class="essay-like-button inline-flex items-center gap-2 rounded-full bg-zinc-100 px-3 py-1 text-third-text-color transition-colors hover:text-primary-color dark:bg-zinc-800"
					data-essay-slug="<%= essay.slug %>"
					data-base-likes="<%= essay.likes || 0 %>"
					aria-pressed="false"
				>
					<span>点赞</span>
					<span class="essay-like-count"><%= essay.likes || 0 %></span>
				</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
