<div class="mb-6 flex flex-col gap-4">
	<%
    const authorName = config.author || config.title || 'Yigod';
    const essays = getNormalizedEssays(theme.essays);
    const archiveGroups = [];
    let lastArchiveKey = null;
    essays.forEach((essay, index) => {
      const monthMoment = moment(essay.date, ['YYYY-MM-DD HH:mm:ss', 'YYYY-MM-DD HH:mm'], true);
      const monthKey = monthMoment.isValid() ? monthMoment.format('YYYY-MM') : `group-${index}`;
      const monthLabel = monthMoment.isValid() ? monthMoment.format('YYYY 年 MM 月') : '未分组';
      const entryId = `essay-entry-${essay.slug || index}`;
      if (monthKey !== lastArchiveKey) {
        archiveGroups.push({
          key: monthKey,
          label: monthLabel,
          headingId: `essay-group-${monthKey}`,
          entries: [],
        });
        lastArchiveKey = monthKey;
      }
      archiveGroups[archiveGroups.length - 1].entries.push({
        id: entryId,
        title: essay.title || (essay.content || '').slice(0, 24) || '说说',
        pinned: essay.pinned,
      });
    });
    const initialArchiveKey = archiveGroups[0]?.key || '';
    %>
	<div class="flex items-center justify-between gap-4">
		<div class="flex flex-col gap-1">
			<h1 class="page-title-header !mb-0"><%= page.title %></h1>
			<p class="text-sm text-third-text-color">记录日常，不做额外修饰。</p>
		</div>
		<div class="hidden text-xs uppercase tracking-[0.2em] text-third-text-color md:block">Timeline</div>
	</div>
	<div class="essay-filter-panel rounded-[1.2rem] border border-border-color bg-background-color-transparent-80 p-4">
		<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
			<label class="flex flex-col gap-1.5 text-xs text-third-text-color">
				<span>关键词</span>
				<input id="essay-search-input" type="search" placeholder="内容、地点或标题" class="essay-filter-input rounded-lg border border-border-color bg-background-color px-3 py-2 text-sm text-first-text-color outline-none transition-colors focus:border-primary-color">
			</label>
			<label class="flex flex-col gap-1.5 text-xs text-third-text-color">
				<span>月份</span>
				<input id="essay-month-input" type="month" class="essay-filter-input rounded-lg border border-border-color bg-background-color px-3 py-2 text-sm text-first-text-color outline-none transition-colors focus:border-primary-color">
			</label>
			<label class="flex flex-col gap-1.5 text-xs text-third-text-color">
				<span>开始日期</span>
				<input id="essay-date-from" type="date" class="essay-filter-input rounded-lg border border-border-color bg-background-color px-3 py-2 text-sm text-first-text-color outline-none transition-colors focus:border-primary-color">
			</label>
			<label class="flex flex-col gap-1.5 text-xs text-third-text-color">
				<span>结束日期</span>
				<input id="essay-date-to" type="date" class="essay-filter-input rounded-lg border border-border-color bg-background-color px-3 py-2 text-sm text-first-text-color outline-none transition-colors focus:border-primary-color">
			</label>
		</div>
		<div class="mt-3 flex flex-wrap items-center gap-2">
			<button type="button" class="essay-filter-button inline-flex items-center rounded-full bg-zinc-100 px-3 py-1 text-sm text-third-text-color transition-colors hover:text-primary-color dark:bg-zinc-800" data-filter="all" aria-pressed="true">全部</button>
			<button type="button" class="essay-filter-button inline-flex items-center rounded-full bg-zinc-100 px-3 py-1 text-sm text-third-text-color transition-colors hover:text-primary-color dark:bg-zinc-800" data-filter="pinned" aria-pressed="false">只看置顶</button>
			<button id="essay-filter-reset" type="button" class="inline-flex items-center rounded-full border border-border-color px-3 py-1 text-sm text-third-text-color transition-colors hover:text-primary-color">清空筛选</button>
			<span id="essay-filter-summary" class="ml-auto text-xs text-third-text-color" aria-live="polite"><%= essays.length %> 条记录</span>
		</div>
	</div>
	<details class="rounded-[1.2rem] bg-zinc-100/80 px-4 py-3 dark:bg-zinc-800/80 md:hidden">
		<summary class="cursor-pointer text-sm font-medium text-first-text-color">按月份快速定位</summary>
		<div class="mt-3 flex flex-col gap-4">
			<% archiveGroups.forEach((group) => { %>
			<div class="essay-mobile-archive-group flex flex-col gap-2">
				<div class="text-xs font-semibold text-third-text-color"><%= group.label %> · <%= group.entries.length %></div>
				<div class="flex flex-col gap-1.5">
					<% group.entries.forEach((entry) => { %>
					<a href="#<%= entry.id %>" class="essay-mobile-archive-link text-sm text-third-text-color hover:text-primary-color" data-target-id="<%= entry.id %>">
						<%= entry.pinned ? '置顶 · ' : '' %><%= entry.title %>
					</a>
					<% }) %>
				</div>
			</div>
			<% }) %>
		</div>
	</details>
	<div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
	<div class="archive-container shadow-none hover:shadow-none sm:shadow-redefine sm:hover:shadow-redefine-hover relative flex min-w-0 flex-1 rounded-[1.6rem] bg-background-color-transparent-80 px-5 py-4 md:max-w-[880px]">
		<div class="pointer-events-none absolute top-7 bottom-7 left-[3.625rem] w-px bg-zinc-200 dark:bg-zinc-700"></div>
	<ul class="mb-0 flex min-w-0 flex-1 flex-col">
		<% essays.forEach((e, index) => { %>
		<% const essayDisplay = getEssayDisplayData(e); %>
		<%
        const monthMoment = moment(e.date, ['YYYY-MM-DD HH:mm:ss', 'YYYY-MM-DD HH:mm'], true);
        const monthKey = monthMoment.isValid() ? monthMoment.format('YYYY-MM') : `group-${index}`;
        const monthLabel = monthMoment.isValid() ? monthMoment.format('YYYY 年 MM 月') : '未分组';
        const prevEssay = index > 0 ? essays[index - 1] : null;
        const prevMonthMoment = prevEssay ? moment(prevEssay.date, ['YYYY-MM-DD HH:mm:ss', 'YYYY-MM-DD HH:mm'], true) : null;
        const prevMonthKey = prevMonthMoment && prevMonthMoment.isValid() ? prevMonthMoment.format('YYYY-MM') : null;
        const entryId = `essay-entry-${e.slug || index}`;
        const dayLabel = monthMoment.isValid() ? monthMoment.format('MM-DD') : '';
        const dateKey = monthMoment.isValid() ? monthMoment.format('YYYY-MM-DD') : '';
        const searchText = [e.title, e.content, e.location_name, essayDisplay.exactDate].filter(Boolean).join(' ');
        %>
		<% if (index === 0 || monthKey !== prevMonthKey) { %>
		<li class="essay-group-heading relative pt-2" id="essay-group-<%= monthKey %>">
			<div class="ml-11 inline-flex items-center rounded-full bg-zinc-100 px-3 py-1 text-xs font-medium tracking-[0.12em] text-third-text-color dark:bg-zinc-800">
				<span class="absolute left-[1.45rem] top-[0.95rem] h-2.5 w-2.5 rounded-full border-2 border-zinc-300 bg-white dark:border-zinc-600 dark:bg-zinc-900"></span>
				<%= monthLabel %>
			</div>
		</li>
		<% } %>
		<li class="essay-entry group relative flex w-full flex-row gap-4 px-2 pt-10 pb-6 first:pt-4" id="<%= entryId %>" data-pinned="<%= e.pinned ? 'true' : 'false' %>" data-date-key="<%= dateKey %>" data-search-text="<%= searchText %>" style="scroll-margin-top:calc(var(--navbar-height) + 1rem);">
			<% if (dayLabel) { %>
			<div class="absolute left-[2.7rem] top-3 text-[0.78rem] font-semibold text-third-text-color">
				<%= dayLabel %>
			</div>
			<% } %>
			<div class="absolute left-[1.375rem] top-11 h-3 w-3 rounded-full border-2 border-zinc-300 bg-white dark:border-zinc-600 dark:bg-zinc-900"></div>
			<div class="relative z-[1] h-10 w-10 shrink-0 overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800">
				<%- image_tag(theme.defaults.avatar, {class: "h-full w-full rounded-[0.8rem] object-cover"}) %>
			</div>
			<div class="flex-1">
				<div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-third-text-color" data-date="<%= essayDisplay.relativeDateValue %>">
					<span class="text-[15px] font-semibold tracking-[0.01em] text-first-text-color"><%= authorName %></span>
					<span class="essay-date-exact"><%= essayDisplay.exactDate %></span>
					<% if (e.pinned) { %>
					<span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-500/10 dark:text-amber-200">置顶</span>
					<% } %>
				</div>
				<div class="flex flex-col gap-4">
					<div class="shuoshuo-content text-[15px] leading-8"><%- markdown(e.content) %></div>
					<% if (e.images.length) { %>
					<div class="essay-media-grid grid gap-2.5" style="<%= essayDisplay.gridStyle %>">
						<% for (const image of e.images.slice(0, 9)) { %>
						<button type="button" class="block overflow-hidden rounded-[1rem] bg-[var(--card-background-color)]">
							<img src="<%= image %>" alt="essay image" loading="lazy" style="<%= essayDisplay.imageStyle %>" class="cursor-zoom-in transition-transform duration-300 hover:scale-[1.03]">
						</button>
						<% } %>
					</div>
					<% } %>
					<% if (e.videos.length) { %>
					<div class="flex flex-col gap-3">
						<% for (const video of e.videos) { %>
						<video controls preload="metadata" style="<%= essayDisplay.videoStyle %>" class="rounded-[1rem] bg-black">
							<source src="<%= video %>">
						</video>
						<% } %>
					</div>
					<% } %>
					<% if (e.location_name) { %>
					<div class="flex flex-wrap items-center gap-2 text-sm text-third-text-color">
						<span class="inline-flex items-center rounded-full bg-zinc-100 px-3 py-1 dark:bg-zinc-800">
							地点 · <%= e.location_name %>
						</span>
						<% if (e.location_url) { %>
						<a href="<%= e.location_url %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full bg-zinc-100 px-3 py-1 hover:text-primary-color dark:bg-zinc-800">
							查看地址
						</a>
						<% } %>
					</div>
					<% } %>
					<div class="flex flex-wrap items-center gap-2 pt-1 text-sm">
						<a href="<%= getEssayUrl(e) %>" class="inline-flex items-center rounded-full bg-zinc-100 px-3 py-1 text-third-text-color transition-colors hover:text-primary-color dark:bg-zinc-800">
							详情页
						</a>
						<button
							type="button"
							class="essay-like-button inline-flex items-center gap-2 rounded-full bg-zinc-100 px-3 py-1 text-third-text-color transition-colors hover:text-primary-color dark:bg-zinc-800"
							data-essay-slug="<%= e.slug %>"
							data-base-likes="<%= e.likes %>"
							aria-pressed="false"
						>
							<span>本地喜欢</span>
							<span class="essay-like-count"><%= e.likes %></span>
						</button>
					</div>
				</div>
			</div>
			<% if (index < essays.length - 1) { %>
			<div class="absolute bottom-0 left-19 h-px w-14 bg-zinc-300/95 dark:bg-zinc-700/95"></div>
			<% } %>
		</li>
		<% }) %>
		<li id="essay-filter-empty" class="hidden py-14 text-center text-sm text-third-text-color">没有符合条件的说说，试试调整关键词或日期。</li>
	</ul>
	</div>
	<aside class="essay-archive-wrap hidden md:block md:w-64 shrink-0 self-start md:ml-auto md:pl-2" style="position:sticky;top:calc(var(--navbar-height) + 1rem);">
		<div class="essay-archive-panel rounded-[1.2rem] bg-zinc-100/80 px-4 py-4 dark:bg-zinc-800/80" style="max-height:calc(100vh - var(--navbar-height) - 2rem);overflow-y:auto;padding-right:0.5rem;">
			<div class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-third-text-color">归档</div>
			<div class="essay-archive-nav flex flex-col gap-4">
				<% archiveGroups.forEach((group) => { %>
				<div class="essay-archive-group flex flex-col gap-2" data-group-key="<%= group.key %>">
					<button
						type="button"
						class="essay-archive-group-toggle flex items-center justify-between gap-3 text-left text-sm font-medium text-first-text-color transition-colors hover:text-primary-color"
						data-group-key="<%= group.key %>"
						data-target-id="<%= group.headingId %>"
						style="display:block;border-left:2px solid transparent;padding-left:0.75rem;border-radius:0.25rem;"
						aria-expanded="<%= initialArchiveKey === group.key ? 'true' : 'false' %>"
					>
						<span class="flex items-center gap-2">
							<span><%= group.label %></span>
							<span class="rounded-small bg-third-background-color py-[2px] px-[8px] border border-border-color text-[0.7rem] font-bold text-third-text-color">
								<%= group.entries.length %>
							</span>
						</span>
						<span class="flex items-center gap-2 text-[0.7rem] text-third-text-color">
							<span class="essay-archive-arrow inline-block transition-transform duration-200"><%= initialArchiveKey === group.key ? '▾' : '▸' %></span>
						</span>
					</button>
					<div class="essay-archive-group-items flex flex-col gap-1.5" data-group-key="<%= group.key %>" style="<%= initialArchiveKey === group.key ? '' : 'display:none;' %>">
						<% group.entries.forEach((entry) => { %>
						<a href="#<%= entry.id %>" class="essay-archive-link text-xs text-third-text-color transition-colors hover:text-primary-color" data-group-key="<%= group.key %>" data-target-id="<%= entry.id %>" style="display:block;border-left:2px solid transparent;padding-left:0.75rem;border-radius:0.25rem;">
							<%= entry.pinned ? '置顶 · ' : '' %><%= entry.title %>
						</a>
						<% }) %>
					</div>
				</div>
				<% }) %>
			</div>
		</div>
	</aside>
	</div>
</div>
