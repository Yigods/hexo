$friend-link-item-height = 82px
$friend-link-item-height-tablet = 68px
$friend-link-item-interval = 16px
$friend-link-item-border-radius = 9px

@require '../../common/variables'

.page-template-container
  redefine-container(
    false,
    0,
    0,
    30px,
    30px
  )

  +redefine-mobile()
    padding 1.2rem 0.2rem
    box-shadow none

    &:hover
      box-shadow none

  .page-template-content
    color var(--default-text-color)

    h1, h2, h3, h4, h5, h6
      &:first-child
        margin 6px 0 36px 0
        border-bottom none
        line-height 1

  .shuoshuo-content
    img:hover
      cursor zoom-in

.essay-filter-button[aria-pressed="true"]
  color var(--invert-text-color)
  background var(--primary-color)

.about-profile
  --about-accent-soft rgba(163, 31, 52, 0.12)
  --about-accent-border rgba(163, 31, 52, 0.26)
  display flex
  flex-direction column
  gap 1.25rem

  h2, h3, p
    margin 0

  .about-hero,
  .about-section,
  .about-quote
    border 1px solid var(--border-color)
    background linear-gradient(145deg, var(--card-background-color), var(--background-color))
    box-shadow var(--redefine-box-shadow-flat)

  .about-hero
    position relative
    display grid
    grid-template-columns 132px minmax(0, 1fr)
    gap 1.75rem
    align-items center
    overflow hidden
    padding 2rem
    border-radius 1.35rem

    &::after
      content ''
      position absolute
      right -90px
      top -110px
      width 260px
      height 260px
      border-radius 50%
      background radial-gradient(circle, var(--about-accent-soft), transparent 68%)
      pointer-events none

  .about-hero-avatar
    position relative
    z-index 1
    width 132px
    height 132px

    img
      display block
      width 100%
      height 100%
      margin 0
      border 3px solid var(--background-color)
      border-radius 1.6rem
      object-fit cover
      box-shadow 0 14px 34px rgba(0, 0, 0, 0.2)

  .about-status-dot
    position absolute
    right -3px
    bottom -3px
    width 23px
    height 23px
    border 4px solid var(--card-background-color)
    border-radius 50%
    background #3fb950

  .about-hero-copy
    position relative
    z-index 1
    min-width 0

    h2
      color var(--first-text-color)
      font-size clamp(1.65rem, 4vw, 2.35rem)
      line-height 1.2

  .about-eyebrow,
  .about-section-kicker
    color var(--primary-color)
    font-family GeistMono, monospace
    font-size 0.72rem
    font-weight 700
    letter-spacing 0.16em

  .about-lead
    max-width 650px
    margin-top 0.75rem
    color var(--second-text-color)
    font-size 1rem
    line-height 1.8

  .about-actions
    display flex
    flex-wrap wrap
    gap 0.65rem
    margin-top 1.15rem

  .about-action
    display inline-flex
    align-items center
    gap 0.48rem
    min-height 38px
    padding 0.5rem 0.85rem
    border 1px solid var(--border-color)
    border-radius 999px
    color var(--first-text-color)
    background var(--background-color-transparent-80)
    font-size 0.86rem
    text-decoration none
    transition transform 0.2s ease, border-color 0.2s ease, color 0.2s ease

    &:hover
      color var(--primary-color)
      border-color var(--about-accent-border)
      transform translateY(-2px)

    &.about-action-primary
      color #fff
      border-color var(--primary-color)
      background var(--primary-color)

      &:hover
        color #fff
        filter brightness(1.08)

  .about-section
    padding 1.6rem
    border-radius 1.2rem

  .about-section-heading
    display flex
    align-items flex-end
    justify-content space-between
    gap 1rem
    margin-bottom 1.15rem

    h2
      margin-top 0.18rem
      color var(--first-text-color)
      font-size 1.35rem
      line-height 1.3

  .about-source,
  .about-inline-link
    display inline-flex
    align-items center
    gap 0.4rem
    color var(--third-text-color)
    font-size 0.78rem

  .about-inline-link
    text-decoration none

    &:hover
      color var(--primary-color)

  .about-status-grid
    display grid
    grid-template-columns minmax(0, 1.3fr) minmax(250px, 0.7fr)
    gap 1rem

  .about-terminal
    overflow hidden
    border 1px solid rgba(163, 31, 52, 0.32)
    border-radius 1rem
    color #c9d1d9
    background #0d1117
    box-shadow inset 0 0 40px rgba(163, 31, 52, 0.05)

  .about-terminal-bar
    display flex
    align-items center
    gap 0.38rem
    padding 0.65rem 0.85rem
    border-bottom 1px solid rgba(255, 255, 255, 0.08)
    background #161b22

    span
      width 9px
      height 9px
      border-radius 50%

      &:nth-child(1)
        background #ff5f56

      &:nth-child(2)
        background #ffbd2e

      &:nth-child(3)
        background #27c93f

    code
      margin-left auto
      color #8b949e
      font-size 0.72rem

  .about-terminal-body
    padding 1.1rem
    font-family GeistMono, Consolas, monospace
    font-size 0.82rem

    p
      display grid
      grid-template-columns 118px minmax(0, 1fr)
      gap 0.65rem
      padding 0.28rem 0

      &:first-child,
      &.about-terminal-ready
        display block

    span
      color #8b949e

    strong
      color #f0f3f6
      font-weight 500

    .about-prompt
      color #d6576c

  .about-terminal-ready
    margin-top 0.35rem
    color #f0f3f6

  .about-cursor
    display inline-block
    width 7px
    height 1em
    margin-left 5px
    vertical-align -2px
    background #d6576c
    animation about-cursor-blink 1s steps(1) infinite

  .about-focus-list
    display grid
    gap 0.7rem

  .about-focus-card
    display flex
    gap 0.85rem
    align-items flex-start
    padding 0.85rem
    border 1px solid var(--border-color)
    border-radius 0.9rem
    background var(--background-color-transparent-40)

    > i
      display grid
      flex 0 0 auto
      width 34px
      height 34px
      place-items center
      border-radius 0.7rem
      color var(--primary-color)
      background var(--about-accent-soft)

    h3
      color var(--first-text-color)
      font-size 0.95rem

    p
      margin-top 0.2rem
      color var(--third-text-color)
      font-size 0.78rem
      line-height 1.55

  .about-skill-list
    display flex
    flex-wrap wrap
    gap 0.65rem

    span
      display inline-flex
      align-items center
      gap 0.5rem
      padding 0.58rem 0.8rem
      border 1px solid var(--border-color)
      border-radius 0.75rem
      color var(--second-text-color)
      background var(--background-color-transparent-40)
      font-size 0.86rem
      transition color 0.2s ease, border-color 0.2s ease, transform 0.2s ease

      &:hover
        color var(--primary-color)
        border-color var(--about-accent-border)
        transform translateY(-2px)

      i
        color var(--primary-color)

  .about-github-intro
    margin -0.35rem 0 1rem
    color var(--third-text-color)
    font-size 0.88rem
    line-height 1.65

  .about-github-stats
    a
      display flex
      min-width 0
      min-height 200px
      align-items center
      justify-content center
      overflow hidden
      border 1px solid var(--border-color)
      border-radius 0.95rem
      background var(--background-color-transparent-40)

    img
      display block
      width 100%
      height auto
      min-height 190px
      margin 0
      object-fit contain

  .about-activity-card
    display block
    overflow hidden
    margin-top 0.8rem
    border 1px solid var(--border-color)
    border-radius 0.95rem
    background var(--background-color-transparent-40)

    img
      display block
      width 100%
      height auto
      min-height 180px
      margin 0
      object-fit contain

  .about-data-note
    display flex
    gap 0.45rem
    align-items flex-start
    margin-top 0.75rem
    color var(--third-text-color)
    font-size 0.72rem
    line-height 1.55

  .about-quote
    display flex
    gap 1rem
    padding 1.4rem 1.5rem
    border-color var(--about-accent-border)
    border-radius 1.1rem

    > i
      color var(--primary-color)
      font-size 1.3rem

    h2
      color var(--first-text-color)
      font-size 1.05rem

    p
      margin-top 0.35rem
      color var(--second-text-color)
      font-size 0.88rem
      line-height 1.7

+redefine-mobile()
  .about-profile
    gap 0.9rem

    .about-hero
      grid-template-columns 1fr
      gap 1.15rem
      padding 1.25rem

    .about-hero-avatar
      width 92px
      height 92px

    .about-hero-copy h2
      font-size 1.65rem

    .about-lead
      font-size 0.92rem

    .about-section
      padding 1.1rem

    .about-section-heading
      align-items flex-start
      flex-direction column
      margin-bottom 0.9rem

    .about-status-grid
      grid-template-columns 1fr

    .about-terminal-body p
      grid-template-columns 104px minmax(0, 1fr)
      font-size 0.76rem

    .about-terminal-bar code
      overflow hidden
      max-width 170px
      text-overflow ellipsis
      white-space nowrap

    .about-github-stats a
      min-height 145px

    .about-activity-card img
      min-height 130px

    .about-quote
      padding 1.15rem

@media (prefers-reduced-motion: reduce)
  .about-profile
    .about-cursor
      animation none

    .about-action,
    .about-skill-list span
      transition none

@keyframes about-cursor-blink
  0%, 48%
    opacity 1

  49%, 100%
    opacity 0

.essay-entry,
.essay-group-heading
  scroll-margin-top calc(var(--navbar-height) + 1rem)


#masonry-container
  position relative
  display block
  opacity 1
  min-height 20vh

  .masonry-item
    position absolute
    box-sizing border-box

    &:hover
      img
        box-shadow var(--redefine-box-shadow)

    img
      width 100%
      border-radius $redefine-border-radius-medium
      box-shadow var(--redefine-box-shadow-flat)
      cursor zoom-in

  img[lazyload]
    padding 0
    margin 0 !important
    cursor zoom-in
    pointer-events auto

.masonry-img
  width 100%
  height auto
  transition box-shadow 0.3s ease-in-out, opacity 0.35s ease
  overflow hidden

  &.is-loading
    opacity 0

.masonry-loadmore
  display flex
  align-items center
  justify-content center
  gap 10px
  margin 20px 0 10px
  min-height 28px
  color var(--second-text-color)
  font-size 0.95rem

  &.is-hidden
    display none

.masonry-loadmore-text
  position absolute
  width 1px
  height 1px
  padding 0
  margin -1px
  overflow hidden
  clip rect(0, 0, 0, 0)
  clip-path inset(50%)
  border 0
  white-space nowrap

.masonry-spinner
  width 18px
  height 18px
  border 2px solid var(--border-color)
  border-top-color var(--primary-color)
  border-radius $redefine-border-radius-full
  animation masonry-spin 0.8s linear infinite

#masonry-sentinel
  width 100%
  height 1px

@keyframes masonry-spin
  0%
    transform rotate(0deg)

  100%
    transform rotate(360deg)

/* Images */
.image-container
  position relative

.image-container.has-ratio
  aspect-ratio var(--masonry-aspect-ratio)

.image-title
  position absolute
  top 5px
  left 5px
  color var(--default-text-color)
  background-color var(--background-color-transparent-40)
  padding 5px 10px
  font-size 14px
  opacity 0
  backdrop-filter blur(10px)
  -webkit-backdrop-filter blur(10px)
  border-radius $redefine-border-radius-small
  transition opacity 0.2s ease-out

.image-description
  position absolute
  bottom 11px
  right 5px
  color var(--default-text-color)
  background-color var(--background-color-transparent-40)
  padding 5px 10px
  font-size 14px
  opacity 0
  max-width 80%
  backdrop-filter blur(10px)
  -webkit-backdrop-filter blur(10px)
  border-radius $redefine-border-radius-small
  transition opacity 0.2s ease-out

figure.image-caption
  img
    margin-bottom 0

  figcaption
    margin-top 5px
    margin-bottom 10px
    text-align center
    font-size 0.9rem
    color var(--third-text-color)

.image-container:hover .image-title, .image-container:hover .image-description
  opacity 1

.image-container img
  width 100%
  height auto
  transition box-shadow 0.3s ease-in-out, filter 0.4s ease, opacity 0.4s ease, transform 0.4s ease
  overflow hidden

.image-container:hover img
  box-shadow var(--redefine-box-shadow-hover)
